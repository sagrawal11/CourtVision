# Copy to .env (backend) or .env.local (frontend) and fill in values.
# NEVER commit .env or .env.local to git.

# ── Backend (.env in repo root or backend/) ───────────────────────────────────

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Full URL this backend is reachable at (used by CV jobs for callbacks)
BACKEND_URL=http://localhost:8000

# Shared secret authenticating server→server CV-job callbacks
# (e.g. PATCH /api/videos/{id}/debug-video-ready). REQUIRED in production.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTERNAL_JOB_SECRET=

# ── AWS / SQS (production only — leave blank for local dev) ───────────────────

# When set, analysis jobs are dispatched to SQS instead of running locally.
# Get this value from Terraform output: sqs_queue_url
SQS_QUEUE_URL=

AWS_REGION_NAME=us-east-1

# ── CV Worker (.env at /app/.env on the EC2 instance) ─────────────────────────
# Same vars as backend above, plus:

# SQS_QUEUE_URL=  (required on EC2 worker)
# PYTHONPATH=/app  (set in systemd unit, not here)

# ── Frontend (.env.local in frontend/) ────────────────────────────────────────

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend URL — use ALB DNS from Terraform output in production
NEXT_PUBLIC_API_URL=http://localhost:8000
